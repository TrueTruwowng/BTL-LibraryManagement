<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../../ScreenUI/css/game.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.Controller.gameController">
    <children>
        <Label fx:id="resultLabel" alignment="CENTER" layoutX="150.0" layoutY="30.0" prefHeight="50.0" prefWidth="300.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Result" AnchorPane.topAnchor="30.0" />
        <Label fx:id="scoreLabel" alignment="CENTER" layoutX="150.0" layoutY="101.0" prefHeight="30.0" prefWidth="300.0" style="-fx-font-size: 18px;" text="Score:" />
        <ProgressIndicator fx:id="correctProgressIndicator" layoutX="145.0" layoutY="160.0" minHeight="100.0" minWidth="100.0" prefHeight="100.0" prefWidth="100.0" style="-fx-progress-color: green; -fx-progress-border: 10; -fx-box-border: green;" />
        <Label alignment="CENTER" layoutX="145.0" layoutY="270.0" prefWidth="100.0" style="-fx-font-size: 14px; -fx-text-fill: green;" text="Đúng" />
        <ProgressIndicator fx:id="wrongProgressIndicator" layoutX="355.0" layoutY="160.0" minHeight="100.0" minWidth="100.0" prefHeight="100.0" prefWidth="100.0" style="-fx-progress-color: red; -fx-progress-border: 10; -fx-box-border: red;" />
        <Label alignment="CENTER" layoutX="355.0" layoutY="270.0" prefWidth="100.0" style="-fx-font-size: 14px; -fx-text-fill: red;" text="Sai" />
        <JFXButton fx:id="replayButton" layoutX="150.0" layoutY="320.0" mnemonicParsing="false" onAction="#replayGame" prefHeight="40.0" prefWidth="150.0" text="Replay" textFill="WHITE" AnchorPane.leftAnchor="120.0" />
        <JFXButton fx:id="quitButton" layoutX="320.0" layoutY="320.0" mnemonicParsing="false" onAction="#quitGame" prefHeight="40.0" prefWidth="150.0" text="Quit" textFill="WHITE" AnchorPane.rightAnchor="120.0" />
    </children>

</AnchorPane>
