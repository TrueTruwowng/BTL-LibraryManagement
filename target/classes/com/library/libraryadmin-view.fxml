<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white;" stylesheets="@../../ScreenUI/css/libraryAdmin.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.LibraryAdminController">
    <top>
        <VBox prefHeight="123.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
            <children>
                <BorderPane maxHeight="67.0" prefHeight="67.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to right,#2b579a , #4facfe); -fx-background-radius: 10 10 0 0;">
                    <center>
                        <Label text="TUY-LIBRARY" textFill="WHITE" BorderPane.alignment="CENTER" style="-fx-font-family: 'Algerian'; -fx-font-size: 23px">
                            <font>
                                <Font name="System Bold" size="23.0" />
                            </font>
                        </Label>
                    </center>
                </BorderPane>
                <VBox prefHeight="117.0" prefWidth="1000.0" style="-fx-background-color: white;">
                    <children>
                        <HBox prefHeight="117.0" prefWidth="953.0" spacing="10.0">
                            <children>
                                <Label alignment="CENTER" prefHeight="73.0" prefWidth="200.0" style="-fx-text-fill: #2b579a;" text="Books">
                                    <font>
                                        <Font name="Segoe UI Semilight" size="46.0" />
                                    </font>
                                    <padding>
                                        <Insets left="10.0" />
                                    </padding>
                                    <HBox.margin>
                                        <Insets left="10.0" />
                                    </HBox.margin>
                                </Label>
                                <Region prefHeight="85.0" prefWidth="14.0" HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER_RIGHT" prefHeight="85.0" prefWidth="789.0" spacing="10.0" HBox.hgrow="NEVER">
                                    <children>
                                        <VBox prefHeight="85.0" prefWidth="794.0" HBox.hgrow="NEVER">
                                            <children>
                                                <HBox prefHeight="26.0" prefWidth="700.0" spacing="10.0" VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <FontAwesomeIcon fx:id="searchIcon" fill="#2b579a" glyphName="SEARCH" size="26">
                                                            <HBox.margin>
                                                                <Insets top="25.0" />
                                                            </HBox.margin></FontAwesomeIcon>
                                                        <TextField fx:id="bookSearchTextField" onKeyTyped="#searchBook" prefHeight="26.0" prefWidth="536.0" promptText="Search book" style="-fx-border-radius: 10; -fx-background-radius: 10;">
                                                            <HBox.margin>
                                                                <Insets top="25.0" />
                                                            </HBox.margin>
                                                            <font>
                                                                <Font size="12.1" />
                                                            </font>
                                                        </TextField>
                                                        <HBox alignment="TOP_RIGHT" prefHeight="26.0" prefWidth="160.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <JFXButton fx:id="addBookButton" onAction="#addBook" prefHeight="25.0" prefWidth="125.0" style="-fx-background-radius: 10; -fx-border-radius: 10;" text="Add Book">
                                                                    <HBox.margin>
                                                                        <Insets right="20.0" top="25.0" />
                                                                    </HBox.margin>
                                                                    <graphic>
                                                                        <FontAwesomeIcon fill="WHITE" glyphName="BOOK" size="17" />
                                                                    </graphic>
                                                                    <font>
                                                                        <Font name="Segoe UI Semilight" size="12.0" />
                                                                    </font>
                                                                </JFXButton>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                    <VBox.margin>
                                                        <Insets />
                                                    </VBox.margin>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                        <HBox maxWidth="3000.0" prefHeight="45.0" prefWidth="1000.0" style="-fx-background-color: white;">
                            <children>
                                <ProgressBar fx:id="progressBar" maxWidth="10000.0" prefWidth="1000.0" progress="1.0" scaleY="0.4" stylesheets="@../../ScreenUI/css/libraryAdmin.css" HBox.hgrow="ALWAYS">
                                    <HBox.margin>
                                        <Insets left="3.0" right="5.0" />
                                    </HBox.margin>
                                </ProgressBar>
                            </children>
                            <VBox.margin>
                                <Insets />
                            </VBox.margin></HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tableBookView" prefHeight="523.0" prefWidth="990.0" style="-fx-background-radius: 10; -fx-border-radius: 10;" stylesheets="@../../ScreenUI/css/TableViewSstyle.css" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="bookIsbnColumn" prefWidth="129.0" text="Book ISBN" />
                <TableColumn fx:id="bookTitleColumn" prefWidth="200.0" text="Book Title" />
                <TableColumn fx:id="bookAuthorColumn" prefWidth="169.0" text="Book Author" />
                <TableColumn fx:id="bookYearColumn" prefWidth="48.0" text="Year" />
                <TableColumn fx:id="bookAvailableColumn" prefWidth="60.0" text="Available" />
                <TableColumn fx:id="bookImageColumn" text="Image" />
                <TableColumn fx:id="bookDescriptionColumn" prefWidth="168.0" text="Description" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </BorderPane.margin>
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#DeleteBook" text="Delete Book" />
                    </items>
                </ContextMenu>
            </contextMenu>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <HBox prefHeight="32.0" prefWidth="1000.0" spacing="5.0" BorderPane.alignment="CENTER">
            <children>
                <Hyperlink fx:id="deleteHyperlink" onAction="#deleteselectedBooks" text="Delete" textFill="#2b579a">
                    <graphic>
                        <FontAwesomeIcon glyphName="TRASH" size="15" />
                    </graphic>
                    <HBox.margin>
                        <Insets left="50.0" top="2.0" />
                    </HBox.margin>
                </Hyperlink>
            <Hyperlink fx:id="saveHyperlink" onAction="#saveSelectedBook" text="Save" textFill="#2b579a">
               <HBox.margin>
                  <Insets left="50.0" top="2.0" />
               </HBox.margin>
               <graphic>
                  <FontAwesomeIcon glyphName="SAVE" size="15" />
               </graphic>
            </Hyperlink>
            </children>
        </HBox>
    </bottom>
</BorderPane>
