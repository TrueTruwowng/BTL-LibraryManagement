<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.LibraryController">
  <children>
    <TableView fx:id="tableBooks" layoutX="20" layoutY="20" prefHeight="400.0" prefWidth="800.0">
      <columns>
        <TableColumn fx:id="colTitle" prefWidth="150" text="Title" />
        <TableColumn fx:id="colAuthor" prefWidth="150" text="Author" />
        <TableColumn fx:id="colYear" prefWidth="184.0" text="Year" />
      </columns>
    </TableView>

    <TextField fx:id="txtTitle" layoutX="49.0" layoutY="446.0" prefHeight="26.0" prefWidth="220.0" promptText="Book Title" />
    <TextField fx:id="txtAuthor" layoutX="320.0" layoutY="446.0" prefHeight="26.0" prefWidth="220.0" promptText="Author" />
    <TextField fx:id="txtYear" layoutX="591.0" layoutY="446.0" prefHeight="26.0" prefWidth="220.0" promptText="Year" />

    <Button layoutX="727.0" layoutY="527.0" onAction="#handleAddBook" prefHeight="26.0" prefWidth="84.0" text="Add Book" />
    <Button layoutX="617.0" layoutY="527.0" onAction="#handleDeleteBook" text="Delete Book" />
  </children>
</AnchorPane>
