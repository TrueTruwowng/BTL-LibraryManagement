<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="602.0" prefWidth="975.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.LibraryController">
  <children>
    <TableView fx:id="tableBooks" layoutX="70.0" layoutY="14.0" prefHeight="390.0" prefWidth="849.0" AnchorPane.rightAnchor="56.0">
      <columns>
        <TableColumn fx:id="colISBN" prefWidth="100" text="ISBN" />
        <TableColumn fx:id="colTitle" prefWidth="150" text="Title" />
        <TableColumn fx:id="colDescription" prefWidth="150" text="Description" />
        <TableColumn fx:id="colCategory" prefWidth="100" text="Category" />
        <TableColumn fx:id="colEdition" prefWidth="100" text="Edition" />
        <TableColumn fx:id="colPublisherId" prefWidth="100" text="Publisher ID" />
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>

    <TextField fx:id="txtISBN" layoutX="77.0" layoutY="419.0" prefHeight="26.0" prefWidth="142.0" promptText="ISBN" />
    <TextField fx:id="txtTitle" layoutX="234.0" layoutY="419.0" prefHeight="26.0" prefWidth="220.0" promptText="Book Title" />
    <TextField fx:id="txtDescription" layoutX="473.0" layoutY="419.0" prefHeight="26.0" prefWidth="160.0" promptText="Description" />
    <TextField fx:id="txtCategory" layoutX="642.0" layoutY="419.0" prefHeight="26.0" prefWidth="110.0" promptText="Category" />
    <TextField fx:id="txtEdition" layoutX="77.0" layoutY="455.0" prefHeight="26.0" prefWidth="142.0" promptText="Edition" />
    <TextField fx:id="txtPublisherId" layoutX="234.0" layoutY="455.0" prefHeight="26.0" prefWidth="220.0" promptText="Publisher ID" />

    <Button layoutX="835.0" layoutY="490.0" onAction="#handleAddBook" prefHeight="26.0" prefWidth="84.0" text="Add Book" />
    <Button layoutX="733.0" layoutY="490.0" onAction="#handleDeleteBook" text="Delete Book" />

    <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="740.0" layoutY="88.0" pickOnBounds="true" preserveRatio="true" />
  </children>
</AnchorPane>
